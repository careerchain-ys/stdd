{
  "description": "STDD spec-first Poka-Yoke hook（packages/core から生成・直接編集しない）",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/spec-first-check.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
