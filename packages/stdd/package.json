{
  "name": "@careerchain/stdd",
  "version": "0.1.0",
  "description": "STDD (Spec and Test Driven Development) を既存・新規プロジェクトに導入する CLI",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "stdd": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "scripts": {
